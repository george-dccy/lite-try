{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Concept",
  "type": "object",
  "required": ["id", "version", "status", "source_blueprint", "core_cognitive_turn", "visual_argument", "beats", "must_preserve"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "status": {"enum": ["concept", "review", "approved", "retired"]},
    "source_blueprint": {"type": "string"},
    "target_duration": {"type": "object"},
    "core_cognitive_turn": {"type": "string"},
    "visual_argument": {"type": "string"},
    "recurring_motifs": {"type": "array", "items": {"type": "string"}},
    "sound_design": {"type": "object"},
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "visual_state", "cognitive_function"],
        "properties": {
          "id": {"type": "string"},
          "duration_sec": {"type": "number", "minimum": 0},
          "visual_state": {"type": "string"},
          "audio_state": {"type": "string"},
          "cognitive_function": {"type": "string"},
          "transition": {"type": "string"}
        }
      }
    },
    "narration_policy": {"type": "object"},
    "text_policy": {"type": "object"},
    "must_preserve": {"type": "array", "items": {"type": "string"}},
    "renderer_handoff": {"type": "object"}
  }
}
